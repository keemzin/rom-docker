# ==============================================================================
# Ragnarok M: Eternal Love - Docker Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

#I remove hardcoded ip already, btu since the apps still point to 192.168.1.234, so keep usign it, untill i release updatefor custom ip.
#SERVER_IP=127.0.0.1
#SERVER_IP=100.75.130.82
SERVER_IP=192.168.1.234

# MySQL Credentials
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=ro_global
MYSQL_PORT=3306

# Redis Settings
REDIS_PORT=6379

# Web Services
WEB_PORT_HTTP=80
WEB_PORT_PORTAL=81
WEB_PORT_API=5556
EQUIPMENT_SHOP_ENABLED=true

# Core Game Server Ports
GATEWAY_PORT_1=7080
GATEWAY_PORT_2=7081
GATEWAY_PORT_3=7082
SUPER_SERVER_PORT=7050

# Exchange (Trade Server) Ports
TRADE_SERVER_PORT=6091
TRADE_SERVER_PORT_ALT=26091

# Proxy Ports
PROXY_PORT_1=12053
PROXY_PORT_2=14288
