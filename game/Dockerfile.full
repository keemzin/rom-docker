ARG BASE_IMAGE=johnsdoes/rom-game:base
FROM ${BASE_IMAGE}

# Bake all 21 C++ game server binaries, lua scripts, and configs directly into image
COPY server/ /RoServercode/

WORKDIR /RoServercode/bin/Release
RUN chmod +x /RoServercode/bin/Release/*Server /RoServercode/bin/Release/go /RoServercode/bin/Release/restart 2>/dev/null || true

EXPOSE 7050 7080 7081 7082 6091 26091 12053 14288
ENTRYPOINT ["/entrypoint.sh"]
